# ============================================================================
# EisenFlow — Appwrite
# Copie para .env e preencha. NÃO comite o .env preenchido.
# ============================================================================

# ---------- Frontend (Vite) ----------
VITE_APPWRITE_ENDPOINT=https://appwrite.kz3solucoes.cloud/v1
VITE_APPWRITE_PROJECT_ID=default-6a987e930039a4a13bea

# ---------- Scripts de migração (só no terminal do servidor) ----------
APPWRITE_ENDPOINT=https://appwrite.kz3solucoes.cloud/v1
APPWRITE_PROJECT_ID=default-6a987e930039a4a13bea
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=eisenflow

# ---------- Functions: IA (OmniRoute self-hospedado) ----------
# Substitui o Lovable AI Gateway. Fala o protocolo OpenAI, então trocar de
# modelo é só mudar AI_MODEL — nenhuma função precisa ser tocada.
AI_PROVIDER=omniroute
AI_BASE_URL=https://omniroute.kz3solucoes.cloud/v1
AI_API_KEY=
AI_MODEL=
# Alternativas caso o OmniRoute saia do ar: openai | anthropic | google | openai-compat

# ---------- Functions: WhatsApp (Evolution API) ----------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Novo: valida a origem do webhook. O original aceitava qualquer POST.
EVOLUTION_WEBHOOK_SECRET=

# ---------- Functions: Google Calendar ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKENS_ENCRYPTION_KEY=

# ---------- Functions: internas ----------
# Novo: exigido em chamadas function -> function (whatsapp-send, crons manuais)
INTERNAL_FUNCTION_SECRET=
# Base pública das functions, usada para montar a URL do webhook da Evolution
PUBLIC_WEBHOOK_BASE_URL=https://appwrite.kz3solucoes.cloud/v1/functions
