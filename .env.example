# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Google OAuth Configuration
# IMPORTANT: Store these in Supabase Vault, NOT in .env files in production
# Get these from: https://console.cloud.google.com/apis/credentials
# For local development only, you can add these here
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"

# Token Encryption Key
# IMPORTANT: This MUST be set in Supabase Vault for production
# Generate a 32-byte (256-bit) random key for AES-256 encryption
# Example: openssl rand -base64 32
# Store in Supabase Vault with: select vault.create_secret('GOOGLE_TOKENS_ENCRYPTION_KEY', 'your-key-here');
# GOOGLE_TOKENS_ENCRYPTION_KEY="your-encryption-key-here"

# Supabase Service Role Key (Edge Functions only, NEVER in client-side code)
# This is used in edge functions to perform privileged operations like token encryption
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# WhatsApp Configuration (if using WhatsApp integration)
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_PHONE_NUMBER=""
# WHATSAPP_API_TOKEN=""
